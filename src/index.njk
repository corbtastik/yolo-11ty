---
layout: layouts/hub.njk
---

<header>
  <div class="yolo-header">
    <div class="yolo-site-info">
      <h1 class="tag no-toc">Yolo Hub</h1>
      <h4 class="description no-toc">Loveable single pages</h4>
    </div>
  </div>
</header>

<div class="hub-search">
  <input type="text" id="hub-search" class="hub-search-input" placeholder="Find it...">
</div>

<div class="hub-posts">
  {% for post in posts %}
  <div class="hub-card">
    <div class="hub-card-header">
      <h2 class="hub-card-title">
        <a href="{{ post.url }}">{{ post.title }}</a>
      </h2>
      <span class="hub-card-date">{{ post.date | date('MMMM D, YYYY') }}</span>
    </div>
    <p class="hub-card-description">{{ post.description }}</p>
    <div class="hub-card-tags">
      {% for tag in post.tags %}<a href="#" class="hub-tag">#{{ tag }}</a>{% endfor %}
    </div>
  </div>
  {% endfor %}
</div>

<div id="hub-no-results" class="hub-no-results" style="display: none;">
  No posts found matching your search.
</div>
