---
layout: layouts/hub.njk
---

<header>
  <div class="yolo-header">
    <div class="yolo-site-info">
      <h1 class="tag no-toc">Yolo Hub</h1>
      <h4 class="description no-toc">Loveable single pages</h4>
    </div>
  </div>
</header>

<div class="hub-search">
  <input type="text" id="hub-search" class="hub-search-input" placeholder="Find it...">
</div>

<div id="hub-posts" class="hub-posts">
  {# Posts will be rendered by JavaScript #}
</div>

<div id="hub-no-results" class="hub-no-results" style="display: none;">
  No posts found matching your search.
</div>

<div id="hub-pagination" class="hub-pagination">
  {# Pagination will be rendered by JavaScript #}
</div>

<script>
  // Pass posts data and config to Hub
  YoloUtils.domReady(function() {
    var postsData = {{ posts | dump | safe }};
    var postsPerPage = {{ settings.hub.postsPerPage | default(25) }};
    window.hub = new YoloHub({
      posts: postsData,
      postsPerPage: postsPerPage
    });
  });
</script>
