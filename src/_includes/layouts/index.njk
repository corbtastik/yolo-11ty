{% if settings.hub.enabled %}
{# Hub mode: Show post listing #}
{% set isHub = true %}
<!DOCTYPE html>
<html lang="en" class="yolo-themed">
{% include "components/head.njk" %}
<body id="yolo-site">
  {% include "components/sticky-controls.njk" %}
  <div id="yolo-container" class="container {{ settings.align | default('left') }}">
    <main>
      <div id="page-content" class="page-content">
        {{ content | safe }}
      </div>
    </main>
    <footer>
      {% include "components/footer.njk" %}
    </footer>
  </div>
  {% include "components/scripts.njk" %}
</body>
</html>
{% else %}
{# Single-page mode: Show first post content #}
{% set mainPost = collections.post | first %}
<!DOCTYPE html>
<html lang="en" class="yolo-themed">
{% include "components/head.njk" %}
<body id="yolo-site" class="{% if settings.sidebar %}sidebar-{{ settings.sidebar.position | default('left') }}{% endif %}">
  {% if settings.sidebar %}
  {% include "components/sidebar.njk" %}
  {% endif %}
  {% include "components/sticky-controls.njk" %}
  <div id="yolo-container" class="container {{ settings.align | default('left') }}">
    <header>
      {% include "components/header.njk" %}
    </header>
    {% include "components/search.njk" %}
    <main style="clear: both">
      <div id="page-content" class="page-content">
        {% if mainPost %}
        {{ mainPost.content | safe }}
        {% else %}
        {{ content | safe }}
        {% endif %}
      </div>
    </main>
    <footer>
      {% include "components/footer.njk" %}
    </footer>
  </div>
  {% include "components/scripts.njk" %}
</body>
</html>
{% endif %}
