<div class="yolo-header">
    <div class="yolo-site-info">
        <h1 class="tag no-toc"><a href="./">{{ settings.name }}</a></h1>
        <h4 class="description no-toc">{{ settings.description }}</h4>
        <p>
            <span>
            {% for link in links %}
            {% set linkref = link | split(",") %}
                <a href="{{ linkref[1] }}" class="yolo-pill">{{ linkref[0] }}</a>
            {% endfor %}
            </span>
        </p>
    </div>
</div>
