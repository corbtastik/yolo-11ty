{# relative_url already applies settings.baseurl - do not prefix it again #}
{% if settings.hub.enabled %}
<script src="{{ '/assets/js/hub.js' | relative_url }}"></script>
{% endif %}
<script src="{{ '/assets/ext/js/search.js' | relative_url }}"></script>
{% for js_name in pageExtJs %}
<script src="{{ ('/assets/ext/js/' + js_name + '.js') | relative_url }}"></script>
{% endfor %}
<script src="{{ '/assets/js/yolo.js' | relative_url }}"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.highlight code').forEach(function(block) {
    var parent = block.closest('.highlighter-rouge');
    if (parent && (parent.classList.contains('language-text') || parent.classList.contains('language-plaintext'))) {
      return;
    }
    hljs.highlightElement(block);
  });
});
</script>
