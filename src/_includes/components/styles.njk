<!-- Fonts -->
{% if fonts | size > 0 %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family={% for font in fonts %}{{ font.name | replace(' ', '+') }}{% if font.weights %}:{% endif %}{{ font.weights | remove(' ') }}{% if not loop.last %}|{% endif %}{% endfor %}">
{% endif %}
<!-- Material Icons -->
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<!-- Main site stylesheet, generated via sass -->
<link rel="stylesheet" href="{{ '/css/brand.css' | relative_url }}" />
<link rel="stylesheet" href="{{ '/css/main.css' | relative_url }}" />
{% if settings.hub.enabled %}
<link rel="stylesheet" href="{{ '/css/hub.css' | relative_url }}" />
{% endif %}
<!-- Add custom css if ext_css front-matter exists -->
{% for css_name in ext_css %}
<link rel="stylesheet" href="{{ ('/assets/ext/css/' + css_name + '.css') | relative_url }}" />
{% endfor %}
